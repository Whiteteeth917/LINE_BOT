# LINE Developers Console -> Messaging API channel 設定裡取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 伺服器監聽 port（Render 等平台會自動注入 PORT，這裡只是本機開發用）
PORT=3000

# 每日推播時間（cron 格式，預設每週一到五 07:30，時區見下方 CRON_TIMEZONE）
PUSH_CRON=30 7 * * 1-5
CRON_TIMEZONE=Asia/Taipei

# 盤中檢查排程（每半小時觸發一次，程式內部只在 09:30~13:00 之間才實際推播）
INTRADAY_CRON=*/30 9-13 * * 1-5

# 內容生成模式：template（預設，零成本，純格式化）｜ claude（呼叫本機 claude CLI，需自行處理登入與費用/額度）
CONTENT_MODE=template

# ngrok authtoken（docker compose 的 ngrok 容器使用，https://dashboard.ngrok.com/get-started/your-authtoken）
NGROK_AUTHTOKEN=

# ---- 雲端部署（Render 等）用的備援設定 ----
# 免費方案硬碟是暫時性的，重啟後 data/ 會清空；以下設定在檔案不存在時當作預設值。
# 你的 LINE userId（LINE Developers Console → Basic settings → Your user ID，U 開頭）
LINE_USER_ID=
# 預設觀察名單／停損規則(%)／備註
DEFAULT_WATCHLIST=
DEFAULT_STOP_LOSS_PCT=20
DEFAULT_NOTE=
# 啟動時回補幾個日曆天的行情快取（選股／類股需要至少 80 個交易日）
WARMUP_DAYS=200

# ---- 多使用者資料庫（雲端部署必填，本機可留空改用 data/users.json）----
# https://console.upstash.com → Create Database（Redis，免費方案）→ REST API 區塊
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 互動圖表連結用的對外網址；Render 會自動提供 RENDER_EXTERNAL_URL，通常不用設
PUBLIC_BASE_URL=
