# LINE Developers Console -> Messaging API channel 設定裡取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 伺服器監聽 port（Render 等平台會自動注入 PORT，這裡只是本機開發用）
PORT=3000

# 每日推播時間（cron 格式，預設每週一到五 07:30，時區見下方 CRON_TIMEZONE）
PUSH_CRON=30 7 * * 1-5
CRON_TIMEZONE=Asia/Taipei

# 盤中檢查排程（每半小時觸發一次，程式內部只在 09:30~13:00 之間才實際推播）
INTRADAY_CRON=*/30 9-13 * * 1-5

# 內容生成模式：template（預設，零成本，純格式化）｜ claude（呼叫本機 claude CLI，需自行處理登入與費用/額度）
CONTENT_MODE=template

# ngrok authtoken（docker compose 的 ngrok 容器使用，https://dashboard.ngrok.com/get-started/your-authtoken）
NGROK_AUTHTOKEN=
